# Native settings-screen controls, reviewed against Brave 1.97.56's
# chrome.settingsPrivate.getAllPrefs() BOOLEAN/NUMBER schema. Keep exact paths,
# not entire objects or arbitrary booleans: those also contain runtime state.
# Exclude generated/policy-only keys, import-dialog choices, onboarding/queue
# state and survey enrollment. Add native telemetry keys (handled by separate
# settings APIs), content defaults and reviewed text/list choices explicitly.
# Used for both Preferences and Local State; absent keys are not synthesized.
. as $input |
reduce [
  {path: ["accessibility", "captions", "background_opacity"], type: "number"},
  {path: ["accessibility", "captions", "live_caption_enabled"], type: "boolean"},
  {path: ["accessibility", "captions", "live_caption_mask_offensive_words"], type: "boolean"},
  {path: ["accessibility", "captions", "live_translate_enabled"], type: "boolean"},
  {path: ["accessibility", "captions", "text_opacity"], type: "number"},
  {path: ["alternate_error_pages", "enabled"], type: "boolean"},
  {path: ["auto_pin_new_tab_groups"], type: "boolean"},
  {path: ["autofill", "at_memory", "double_ctrl_trigger_enabled"], type: "boolean"},
  {path: ["autofill", "autofill_ai", "identity_entities_enabled"], type: "boolean"},
  {path: ["autofill", "autofill_ai", "shopping_entities_enabled"], type: "boolean"},
