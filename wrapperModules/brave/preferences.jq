][] as $field ({};
  (try ($input | getpath($field.path)) catch null) as $value |
  if ($value | type) == $field.type
  then setpath($field.path; $value) else . end) |
# Intentional settings, not history. Never export accelerator/keybinding maps.
reduce [["session", "startup_urls"], ["spellcheck", "dictionaries"]][] as $path (.;
  (try ($input | getpath($path)) catch null) as $value |
  if ($value | type) == "array" and ($value | all(.[]; type == "string"))
  then setpath($path; $value) else . end)
